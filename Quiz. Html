<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quiz - E-Learning Management System</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            color: #222;
        }

        .navbar {
            background: #1e3a8a;
            color: white;
            padding: 18px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar h2 {
            margin: 0;
        }

        .back {
            color: white;
            text-decoration: none;
            background: #2563eb;
            padding: 8px 15px;
            border-radius: 6px;
        }

        .container {
            max-width: 800px;
            margin: 35px auto;
            padding: 20px;
        }

        .quiz-box {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .quiz-box h1 {
            text-align: center;
            margin-bottom: 10px;
        }

        .question {
            margin-top: 25px;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 10px;
        }

        .question h3 {
            margin-top: 0;
        }

        label {
            display: block;
            padding: 10px;
            margin: 8px 0;
            background: #f1f5f9;
            border-radius: 6px;
            cursor: pointer;
        }

        label:hover {
            background: #e2e8f0;
        }

        input[type="radio"] {
            margin-right: 10px;
        }

        .submit-btn {
            display: block;
            width: 100%;
            margin-top: 25px;
            padding: 13px;
            border: none;
            border-radius: 7px;
            background: #1e3a8a;
            color: white;
            font-size: 17px;
            cursor: pointer;
        }

        .submit-btn:hover {
            background: #2563eb;
        }

        #result {
            margin-top: 20px;
            text-align: center;
            font-size: 20px;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <div class="navbar">
        <h2>E-Learning LMS</h2>
        <a href="/dashboard" class="back">Dashboard</a>
    </div>

    <div class="container">

        <div class="quiz-box">

            <h1>Course Quiz</h1>
            <p style="text-align:center;">
                Answer all questions and submit the quiz.
            </p>

            <form id="quizForm">

                <div class="question">
                    <h3>1. What does LMS stand for?</h3>

                    <label>
                        <input type="radio" name="q1" value="a">
                        Learning Management System
                    </label>

                    <label>
                        <input type="radio" name="q1" value="b">
                        Learning Machine System
                    </label>

                    <label>
                        <input type="radio" name="q1" value="c">
                        Learning Management Software
                    </label>

                    <label>
                        <input type="radio" name="q1" value="d">
                        Library Management System
                    </label>
                </div>

                <div class="question">
                    <h3>2. Which language is commonly used for web development?</h3>

                    <label>
                        <input type="radio" name="q2" value="a">
                        HTML
                    </label>

                    <label>
                        <input type="radio" name="q2" value="b">
                        Python
                    </label>

                    <label>
                        <input type="radio" name="q2" value="c">
                        Both HTML and Python
                    </label>

                    <label>
                        <input type="radio" name="q2" value="d">
                        None of these
                    </label>
                </div>

                <div class="question">
                    <h3>3. What is used to style a web page?</h3>

                    <label>
                        <input type="radio" name="q3" value="a">
                        HTML
                    </label>

                    <label>
                        <input type="radio" name="q3" value="b">
                        CSS
                    </label>

                    <label>
                        <input type="radio" name="q3" value="c">
                        SQL
                    </label>

                    <label>
                        <input type="radio" name="q3" value="d">
                        Java
                    </label>
                </div>

                <div class="question">
                    <h3>4. Which technology is used to create the structure of a web page?</h3>

                    <label>
                        <input type="radio" name="q4" value="a">
                        CSS
                    </label>

                    <label>
                        <input type="radio" name="q4" value="b">
                        HTML
                    </label>

                    <label>
                        <input type="radio" name="q4" value="c">
                        SQL
                    </label>

                    <label>
                        <input type="radio" name="q4" value="d">
                        Flask
                    </label>
                </div>

                <button type="button" class="submit-btn" onclick="submitQuiz()">
                    Submit Quiz
                </button>

            </form>

            <div id="result"></div>

        </div>

    </div>

    <script>
        function submitQuiz() {

            let score = 0;

            let answers = {
                q1: "a",
                q2: "c",
                q3: "b",
                q4: "b"
            };

            for (let question in answers) {

                let selected = document.querySelector(
                    'input[name="' + question + '"]:checked'
                );

                if (selected && selected.value === answers[question]) {
                    score++;
                }
            }

            let result = document.getElementById("result");

            result.innerHTML =
                "Your Score: " + score + " / 4";

            if (score === 4) {
                result.innerHTML += "<br>Excellent! 🎉";
            } else if (score >= 2) {
                result.innerHTML += "<br>Good job! Keep learning.";
            } else {
                result.innerHTML += "<br>Keep practicing and try again.";
            }
        }
    </script>

</body>
</html>